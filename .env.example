# Mapbox public access token (pk.*). Required for the map to render.
# https://console.mapbox.com/account/access-tokens/
VITE_MAPBOX_TOKEN=

# Optional: override the basemap. Defaults to the Mapbox Standard style,
# which the app then configures for a night-time, 3D look.
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/standard
